# Server Configuration
PORT=5000
NODE_ENV=production
SERVER_URL=https://your-backend-api.onrender.com
CLIENT_URL=https://your-frontend-app.vercel.app

# Database Configuration (MongoDB Atlas for Live Production)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/securevault?retryWrites=true&w=majority

# Security & Authentication
JWT_SECRET=super_secret_jwt_vault_key_2026_change_me_in_production
ENCRYPTION_MASTER_KEY=4a8e6b129c53d1078f4a1e902b4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d

# SMTP EMAIL PROVIDER CONFIGURATION (Gmail SMTP / SendGrid / Resend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail-account@gmail.com
SMTP_PASS=your-16-character-gmail-app-password
EMAIL_FROM="SecureVault" <your-gmail-account@gmail.com>

# Supabase Storage Fallback (Optional)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
